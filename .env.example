export const GEMINI_MODEL = 'gemini-3.8-flash';

export function getGeminiApiKey() {
  const key = import.meta.env.VITE_GEMINI_API_KEY;
  if (!key || key.trim() === '') {
    throw new Error('Missing Gemini API key. Add VITE_GEMINI_API_KEY to your .env file.');
  }
  return key;
}

export async function askGemini(prompt) {
  const apiKey = getGeminiApiKey();

  const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      contents: [
        {
          parts: [
            { text: prompt }
          ]
        }
      ],
      generationConfig: {
        temperature: 0.2,
        topP: 0.8,
        topK: 32,
        maxOutputTokens: 512
      }
    })
  });

  if (!response.ok) {
    const payload = await response.json().catch(() => ({}));
    const message = payload?.error?.message || 'Gemini request failed.';
    throw new Error(message);
  }

  const data = await response.json();
  const answer = data?.candidates?.[0]?.content?.parts?.map((part) => part.text).join('') || 'No answer returned.';
  return answer;
}

export async function analyzeLeaf({ cropName, leafImage, notes }) {
  const prompt = `You are an expert Indian agronomist and plant pathologist. Analyze this crop leaf from ${cropName}.\nContext: ${notes}.\nReturn JSON in this exact schema: {"disease":"...","confidence":number,"remedy":"...","odia":"..."}. Keep the solution practical, organic, and suitable for Indian farmers. Include a concise English remedy and a matching Odia answer. If the image is not actually usable, still provide a cautious diagnosis using visible symptoms described in the note.`;

  try {
    const output = await askGemini(prompt + `\nLeaf reference image: ${leafImage || 'No image provided'}`);
    const jsonText = output.match(/\{[\s\S]*\}/)?.[0] || output;
    const parsed = JSON.parse(jsonText);
    return {
      disease: parsed.disease || 'Healthy with a cautionary review',
      confidence: Number(parsed.confidence) || 80,
      remedy: parsed.remedy || 'Use neem spray, clean leaves, and ensure good airflow.',
      odia: parsed.odia || 'ପତ୍ରକୁ ସଫା କରନ୍ତୁ, ନୀମ ଜଳ ଡିଲ୍‌ଙ୍କ କରନ୍ତୁ ଓ ସୁସ୍ଥ ହୃଷ୍ଟିକଂ ସୁନିଶ୍ଚିତ କରନ୍ତୁ।'
    };
  } catch (error) {
    throw error;
  }
}

export function getLeafAnalysisError(error) {
  if (error?.message?.includes('API key')) {
    return 'Gemini API key is missing. Add VITE_GEMINI_API_KEY to your .env file to enable crop analysis.';
  }

  return 'Leaf scan could not complete. Please retry or use a clearer photo.';
}
